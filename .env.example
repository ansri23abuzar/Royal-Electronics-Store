# Clerk (required - https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_c2Vuc2libGUtc3VuYmlyZC0zNC5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_3zulQZEnovwujbfoKuqAfB7piJ8dkFrAbmyYxtnPGG

# Sanity (required - https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=Your_value_goes_here
NEXT_PUBLIC_SANITY_DATASET=Your_value_goes_here
NEXT_PUBLIC_SANITY_API_VERSION=Your_value_goes_here
NEXT_PUBLIC_SANITY_ORG_ID=Your_value_goes_here
SANITY_API_WRITE_TOKEN=Your_value_goes_here

# Groq (required for AI shopping assistant - https://console.groq.com/keys)
GROQ_API_KEY=Your_value_goes_here
# Optional: override the model (defaults to qwen/qwen3.6-27b). Use a model with
# reliable native tool calling — Qwen3 models work well, Llama models often
# fail with Groq's "Failed to call a function" (tool_use_failed) error.
GROQ_MODEL=qwen/qwen3.6-27b

# Razorpay (optional - only needed for checkout/payments)
RAZORPAY_KEY_ID=Your_value_goes_here
RAZORPAY_KEY_SECRET=Your_value_goes_here

# Optional - public base URL used in Stripe redirect URLs (defaults to localhost:3000)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional - Vercel AI Gateway (only used by the /api/admin/insights route)
AI_GATEWAY_API_KEY=Your_value_goes_here
